# --- Better Auth ---
BETTER_AUTH_SECRET=            # long random string: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# --- MongoDB (same database as the server) ---
